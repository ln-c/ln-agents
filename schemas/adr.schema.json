{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "adr",
  "title": "Accepted ADR written after human approval at H1",
  "type": "object",
  "required": ["id", "title", "status", "approver_id", "reason", "run_id", "approved_at"],
  "properties": {
    "id": {"type": "string", "pattern": "^[0-9]{4}$"},
    "title": {"type": "string", "minLength": 1},
    "status": {"enum": ["accepted", "implemented", "superseded"]},
    "approver_id": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "run_id": {"type": "string"},
    "approved_at": {"type": "string"},
    "implemented_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "supersedes": {"type": "array", "items": {"type": "string"}}
  },
  "if": {"properties": {"status": {"const": "implemented"}}},
  "then": {"required": ["implemented_sha"]}
}
