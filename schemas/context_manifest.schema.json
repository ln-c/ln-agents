{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "context_manifest",
  "title": "Context manifest (G4): hashed and immutable for the run",
  "type": "object",
  "required": ["run_id", "commit_sha", "adrs", "contract_versions", "data_classes", "policy_version", "scorer_version", "hash"],
  "additionalProperties": false,
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "parent_run_id": {"type": ["string", "null"]},
    "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "adrs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": {"type": "string"},
          "status": {"enum": ["proposed", "accepted", "superseded", "deprecated", "implemented"]}
        }
      }
    },
    "contract_versions": {"type": "object", "additionalProperties": {"type": "string"}},
    "data_classes": {
      "type": "object",
      "additionalProperties": {"enum": ["public", "internal", "confidential", "restricted", "unknown"]}
    },
    "policy_version": {"type": "string"},
    "scorer_version": {"type": "string"},
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
