{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "decision_record",
  "title": "Auto-generated decision record (DR). Never a human approval.",
  "type": "object",
  "required": ["id", "run_id", "winner", "policy_version", "auto_generated"],
  "properties": {
    "id": {"type": "string"},
    "run_id": {"type": "string"},
    "winner": {"type": "string"},
    "runner_up": {"type": ["string", "null"]},
    "policy_version": {"type": "string"},
    "auto_generated": {"const": true},
    "rationale": {"type": "string"}
  },
  "not": {
    "anyOf": [
      {"required": ["approver_id"]},
      {"required": ["approved_by"]},
      {"properties": {"status": {"const": "accepted"}}, "required": ["status"]}
    ]
  }
}
