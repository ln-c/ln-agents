{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "conformance_probe",
  "title": "Reply a model must give to the conformance json_reply probe",
  "type": "object",
  "required": ["nonce"],
  "additionalProperties": false,
  "properties": {
    "nonce": {"type": "string", "pattern": "^[0-9a-f]{32}$"}
  }
}
